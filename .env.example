# ─────────────────────────────────────────────────────────────────────────
# Katava Studio — Environment Variables (template, safe to commit)
# Copy to .env and fill in secrets. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────

# Prisma database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# ─── LLM Provider (OpenAI-compatible) ───────────────────────────────────
# "openai" is the only supported provider value.
LLM_PROVIDER="openai"

# Exact setup steps:
#   1. Create a key at https://platform.openai.com/api-keys
#      (or obtain one from your chosen OpenAI-compatible gateway).
#   2. Paste it below. No spaces, inline comments, or nested quotes.
#   3. Verify with a REAL call: npm run verify:llm
# Any OpenAI-compatible gateway can be used by changing BASE_URL / MODEL —
# no code changes are required.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ─── Runtime behaviour ──────────────────────────────────────────────────
# Per-call timeout in milliseconds. On timeout the pipeline returns
# review_incomplete (fail-closed). Never a fabricated success.
LLM_TIMEOUT_MS="20000"

# Application
# NEXT_PUBLIC_APP_NAME is exposed to the browser by design — it is not secret.
NEXT_PUBLIC_APP_NAME="Katava Studio"
